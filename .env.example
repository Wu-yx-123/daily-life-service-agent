# ==========================================================================
# MassageOps-Agent 环境变量示例
# ==========================================================================
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，不会提交到仓库。
# ==========================================================================

# ── 数据库 ──────────────────────────────────────────────────────────────
MASSAGEOPS_DATABASE_URL=postgresql+asyncpg://massageops:massageops@localhost:5432/massageops

# ── Redis ───────────────────────────────────────────────────────────────
MASSAGEOPS_REDIS_URL=redis://localhost:6379/0
# 本地不启动 Redis 时，可临时使用内存锁：MASSAGEOPS_REDIS_URL=memory://

# ── LLM / ModelProvider ─────────────────────────────────────────────────
# 选择 LLM provider：openai | deepseek | qwen | claude
MASSAGEOPS_LLM_PROVIDER=deepseek
# 自定义 API 地址（留空则用 provider 默认值）
MASSAGEOPS_LLM_BASE_URL=
# API Key（必填）
MASSAGEOPS_LLM_API_KEY=your-api-key-here
# 覆盖默认 chat 模型（留空按 provider 自动选择）
MASSAGEOPS_LLM_CHAT_MODEL=
# 覆盖默认 embedding 模型（留空按 provider 自动选择）
MASSAGEOPS_LLM_EMBED_MODEL=

# ── CORS ────────────────────────────────────────────────────────────────
MASSAGEOPS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── 前端（Vite）─────────────────────────────────────────────────────────
# VITE_API_BASE=
